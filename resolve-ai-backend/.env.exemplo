# Copie este arquivo para ".env" no servidor e preencha os valores.

# Banco MySQL criado na aba "Databases" do Pterodactyl (copie os dados de lá).
# Se deixar DB_HOST vazio, usa um arquivo SQLite (resolve_ai.db) dentro do servidor.
DB_HOST=
DB_PORTA=3306
DB_NOME=
DB_USUARIO=
# Coloque a senha entre aspas simples, ex.: DB_SENHA='a1b2!c3#'
DB_SENHA=

# Chave secreta dos logins (JWT). Use um texto longo e aleatório, e não compartilhe.
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# "sim" = cria 52 denúncias de exemplo e os logins de teste (CPF 529.982.247-25 / matrícula 1001).
# "nao" = começa vazio, só com o gestor abaixo. Use "nao" quando for para valer.
# Só vale na primeira vez que o servidor sobe com o banco vazio.
DADOS_DEMO=sim

# Login do primeiro gestor (usado quando DADOS_DEMO=nao). Senha com no mínimo 8 caracteres.
GESTOR_NOME=
GESTOR_MATRICULA=
GESTOR_SENHA=

# Endereços extras que podem chamar a API, separados por vírgula (normalmente não precisa).
CORS_ORIGINS=
